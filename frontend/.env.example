# API Gateway エンドポイント URL (例: https://xxxxxx.execute-api.ap-northeast-1.amazonaws.com/prod)
# 空欄または VITE_USE_MOCK=true の場合はブラウザ LocalStorage を用いたデモ・モックモードで動作します
VITE_API_BASE_URL=
VITE_USE_MOCK=true

# AWS Cognito 設定 (本番運用時)
VITE_COGNITO_REGION=ap-northeast-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

